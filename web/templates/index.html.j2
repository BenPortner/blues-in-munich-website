<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Blues in Munich</title>
  <meta name="description" content="Blues dance classes, workshops, socials and blues concerts in Munich — collected daily from schools, venues and bands.">
  <meta name="color-scheme" content="light dark">
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%231f3a8a'/%3E%3Cpath d='M12 23a3 3 0 1 1-2-2.83V8l11-2v13a3 3 0 1 1-2-2.83V10.4l-7 1.3Z' fill='%23f2c46d'/%3E%3C/svg%3E">
  <link rel="alternate" type="text/calendar" title="Blues in Munich (iCal)" href="events.ics">
  <link rel="stylesheet" href="static/style.css">
</head>
<body>
  <header class="masthead">
    <div class="wrap">
      <p class="eyebrow">Munich · updated daily</p>
      <h1><a href="{{ site_url }}">Blues in Munich</a></h1>
      <p class="lede">Blues dance classes, workshops and socials, plus live blues — gathered from Munich's dance schools, venues and bands.</p>
      <p class="actions">
        <a class="button" id="subscribe" href="{{ webcal_url }}" data-android-href="{{ gcal_url }}">Subscribe to calendar</a>
        <a class="button ghost" href="#sources">Sources</a>
      </p>
    </div>
  </header>

  <main class="wrap">
    {% macro month_sections(months, prefix) %}
    {% for month in months %}
    <section class="month" aria-labelledby="{{ prefix }}{{ loop.index }}">
      <h2 id="{{ prefix }}{{ loop.index }}">{{ month.label }}</h2>
      {% for day in month.days %}
      <div class="day{% if day.is_today %} today{% endif %}">
        <h3 class="day-label"><time datetime="{{ day.day.isoformat() }}">{{ day.label }}</time>{% if day.is_today %} <em>today</em>{% endif %}</h3>
        <div class="cards">
          {% for c in day.cards %}{% set e = c.e %}
          <article class="card type-{{ e.type }}{% if c.highlight %} highlight{% endif %}" data-type="{{ e.type }}" data-source="{{ e.source_id }}"{% if c.highlight %} data-highlight{% endif %}{% if c.regional %} data-regional{% endif %}>
            <p class="meta">
              <span class="badge">{{ c.label }}</span>
              {% if c.highlight %}<span class="star">★ Highlight</span>{% endif %}
              {% if c.span %}<span>{{ c.span }}</span>{% endif %}
              {% if c.time %}<span>{{ c.time }}</span>{% endif %}
            </p>
            <h4><a href="{{ e.url }}" rel="noopener">{{ e.title }}</a></h4>
            {% if e.venue or e.address %}
            <p class="where">{{ e.venue or "" }}{% if e.venue and e.address %} · {% endif %}<span class="address">{{ e.address or "" }}</span></p>
            {% endif %}
            {% if e.artists %}
            <p class="artists">{{ c.artists_label }}: {% for a in e.artists %}<a href="{{ a.url }}" rel="noopener">{{ a.name }}</a>{% if not loop.last %} · {% endif %}{% endfor %}</p>
            {% endif %}
            {% if e.recurrence %}
            <p class="recurrence">{{ e.recurrence }}{% if c.session_count %} · {{ c.session_count }}-week course block{% endif %}{% if c.sessions %}<br><span>{{ c.sessions_label }}: {{ c.sessions }}</span>{% endif %}</p>
            {% endif %}
            {% if e.description %}<p class="desc">{{ e.description }}</p>{% endif %}
            <p class="links">
              <a href="{{ e.url }}" rel="noopener">Event details ↗</a>
              {% if e.school_url %}<a class="school" href="{{ e.school_url }}" rel="noopener">School: {{ e.school_name }} ↗</a>{% endif %}
              {% if e.source_name != e.school_name %}<span class="via">via {{ e.source_name }}</span>{% endif %}
            </p>
          </article>
          {% endfor %}
        </div>
      </div>
      {% endfor %}
    </section>
    {% endfor %}
    {% endmacro %}

    {% if total or past_total %}
    <nav class="filters" aria-label="Filter by type">
      <div class="chips">
      {# Set from a source's event count in the footer; replaces the type chips' choice until cleared #}
      <button type="button" class="chip source-chip" aria-pressed="true" hidden><span class="source-name"></span> <span aria-label="Show all sources">✕</span></button>
      {# data-counts: upcoming events without and with the events outside Munich; the page shows all #}
      <button type="button" class="chip" data-filter="all" aria-pressed="true" data-counts="{{ total_counts | join(' ') }}">All <span>{{ total_counts[1] }}</span></button>
      {% if highlight_chip %}<button type="button" class="chip" data-filter="highlight" aria-pressed="false" data-counts="{{ highlights | join(' ') }}">★ Highlights <span>{{ highlights[1] }}</span></button>{% endif %}
      {% for type, label, count in filters %}
      <button type="button" class="chip" data-filter="{{ type }}" aria-pressed="false" data-counts="{{ count | join(' ') }}">{{ label }} <span>{{ count[1] }}</span></button>
      {% endfor %}
      </div>
      {# Settings, not filters: where (Munich or with the region around it) and how (list or calendar) #}
      <div class="tools">
        {% if region_switch %}
        <div class="place" hidden>
          <button type="button" class="tool place-button" aria-haspopup="true" aria-expanded="false" aria-controls="place-menu">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11Z"/><circle cx="12" cy="10" r="2.3"/></svg>
            <span class="place-label">Munich</span>
            <svg class="chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m7 10 5 5 5-5"/></svg>
          </button>
          <div class="place-menu" id="place-menu" role="menu" hidden>
            <button type="button" role="menuitemradio" aria-checked="true" data-area="city">Munich <span>{{ total_counts[0] }}</span></button>
            <button type="button" role="menuitemradio" aria-checked="false" data-area="region">Munich and region <span>{{ total_counts[1] }}</span></button>
          </div>
        </div>
        {% endif %}
        <span class="views" role="group" aria-label="View" hidden>
          <button type="button" class="tool" data-view="list" aria-pressed="true" aria-label="List" title="List">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6h11M9 12h11M9 18h11M4.5 6h.01M4.5 12h.01M4.5 18h.01"/></svg>
          </button>
          <button type="button" class="tool" data-view="calendar" aria-pressed="false" aria-label="Calendar" title="Calendar">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="5" width="16" height="15" rx="2"/><path d="M4 10h16M8.5 3v4M15.5 3v4"/></svg>
          </button>
        </span>
      </div>
    </nav>

    <div id="list-view">
      {% if spotlight %}
      <section class="spotlight" id="spotlight" aria-labelledby="spotlight-h">
        <h2 id="spotlight-h">★ Upcoming highlights <span>{{ spotlight_label }}</span></h2>
        <ul>
          {% for c in spotlight %}{% set e = c.e %}
          <li class="type-{{ e.type }}"{% if c.regional %} data-regional{% endif %}>
            <time datetime="{{ c.day.isoformat() }}">{{ c.day_label }}{% if c.time %} · {{ c.time.split('–')[0] }}{% endif %}</time>
            <a href="{{ e.url }}" rel="noopener">{{ e.title }}</a>
            {% if e.venue %}<span class="where">{{ e.venue }}</span>{% endif %}
          </li>
          {% endfor %}
        </ul>
      </section>
      {% endif %}
      <div id="upcoming">{{ month_sections(months, "m") }}</div>
      <p class="empty"{% if total %} hidden{% endif %}>{% if total %}No upcoming events of this type right now.{% else %}No upcoming blues events found right now — check back tomorrow.{% endif %}</p>
      {% if past_total %}
      <details class="past" id="past">
        <summary>Past events <span>{{ past_total }}</span></summary>
        {{ month_sections(past_months, "p") }}
      </details>
      {% endif %}
    </div>
    <section id="calendar-view" class="calendar" aria-label="Calendar" hidden></section>
    <script type="application/json" id="calendar-data">{{ calendar_json | safe }}</script>
    {% else %}
    <p class="empty">No upcoming blues events found right now — check back tomorrow.</p>
    {% endif %}
  </main>

  <footer id="sources" class="wrap footer">
    <h2>Sources</h2>
    <p>Collected automatically every morning from these pages. Always check the organiser's page before you go.</p>
    <ul class="sources">
      {% for s in sources if s.kind != "manual" or s.kept %}
      <li>
        <a href="{{ s.url }}" rel="noopener">{{ s.name }}</a>
        {% set n = source_counts[s.id] %}
        {% if s.status == "ok" and n %}<a class="status status-ok" href="#source/{{ s.id }}" data-source-link="{{ s.id }}" data-name="{{ s.name }}">{{ n }} event{{ "" if n == 1 else "s" }}</a>
        {% else %}<span class="status status-{{ s.status }}">{% if s.status == "ok" %}0 events{% elif s.status == "skipped" %}not active{% else %}update failed — showing last known{% endif %}</span>{% endif %}
      </li>
      {% endfor %}
    </ul>
    <p class="small">
      Last updated {{ generated }} (Munich time) ·
      <a href="events.ics">iCal feed</a> · <a href="{{ gcal_url }}">Google Calendar</a> · <a href="events.json">JSON</a>
      {% if repo_url %} · <a href="{{ repo_url }}/issues/new?title=New%20source%3A%20">Suggest a source</a>{% endif %}
      · <a href="impressum.html">Impressum</a> · <a href="datenschutz.html">Datenschutz</a>
    </p>
    {% if lastfm_credit %}
    <p class="small lastfm">Artist info <a href="https://www.last.fm/" rel="noopener">powered by AudioScrobbler</a> (Last.fm)</p>
    {% endif %}
  </footer>
  <script src="static/app.js" defer></script>
</body>
</html>
