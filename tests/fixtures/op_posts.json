[{"id":1690,"date":"2026-10-14T10:08:24","link":"https:\/\/oksanapavlova.de\/aktuelles\/08-11-26-lindy-hop-taster-und-workshops\/","title":{"rendered":"08.11.26 Lindy Hop &#8211; Taster und Workshops"},"content":{"rendered":"\n<div class=\"wp-block-columns is-layout-flex wp-container-core-columns-is-layout-8f761849 wp-block-columns-is-layout-flex\">\n<div class=\"wp-block-column is-vertically-aligned-center is-layout-flow wp-block-column-is-layout-flow\">\n<figure class=\"wp-block-image size-large\"><img loading=\"lazy\" decoding=\"async\" width=\"1024\" height=\"683\" src=\"https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/09\/WS-Stufe-1-1024x683.jpg\" alt=\"\" class=\"wp-image-1602\" srcset=\"https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/09\/WS-Stufe-1-1024x683.jpg 1024w, https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/09\/WS-Stufe-1-300x200.jpg 300w, https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/09\/WS-Stufe-1-768x512.jpg 768w, https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/09\/WS-Stufe-1-1536x1024.jpg 1536w, https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/09\/WS-Stufe-1-2048x1365.jpg 2048w\" sizes=\"auto, (max-width: 1024px) 100vw, 1024px\" \/><\/figure>\n<\/div>\n\n\n\n<div class=\"wp-block-column is-vertically-aligned-center is-layout-flow wp-block-column-is-layout-flow\">\n<p class=\"has-medium-font-size wp-block-paragraph\">Am Sonntag, den 08. November ist es wieder soweit!<br><br>F\u00fcr alle, die Lindy Hop kennenlernen wollen, gibt es  um<br>11:00 einen halbst\u00fcndigen Taster.<br><br>F\u00fcr alle, die Lindy Hop lernen wollen, mache ich einen Workshop f\u00fcr Einsteiger um 12:00. Wer beim Taster auf den Geschmack gekommen ist, bleibt gleich da!<br><br>Alle, die schon einmal Anf\u00e4ngerkurse oder -workshops bei mir mitgemacht haben, k\u00f6nnen dann um 15:30 in einem weiteren Workshop das Gelernte vertiefen.<br><br>Ich freue mich auf euch!<br><br>Zur Anmeldung geht es<br><br><a href=\"https:\/\/forms.gle\/GxXX5M4n6NA6uD7Z6\" target=\"_blank\" rel=\"noopener\">hier.<\/a><\/p>\n<\/div>\n<\/div>\n","protected":false}},{"id":1627,"date":"2026-09-03T08:02:45","link":"https:\/\/oksanapavlova.de\/aktuelles\/shim-sham-workshop-am-10-oktober\/","title":{"rendered":"Shim-Sham! Workshop am 10. Oktober &#8211; Neue Uhrzeit: Beginn 10:00 Uhr"},"content":{"rendered":"\n<div class=\"wp-block-columns are-vertically-aligned-center is-layout-flex wp-container-core-columns-is-layout-8f761849 wp-block-columns-is-layout-flex\">\n<div class=\"wp-block-column is-vertically-aligned-center is-layout-flow wp-block-column-is-layout-flow\">\n<figure class=\"wp-block-image size-large\"><img loading=\"lazy\" decoding=\"async\" width=\"724\" height=\"1024\" src=\"https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/09\/IMG_6842-724x1024.jpg\" alt=\"\" class=\"wp-image-1681\" srcset=\"https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/09\/IMG_6842-724x1024.jpg 724w, https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/09\/IMG_6842-212x300.jpg 212w, https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/09\/IMG_6842-768x1086.jpg 768w, https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/09\/IMG_6842-1086x1536.jpg 1086w, https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/09\/IMG_6842-1448x2048.jpg 1448w, https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/09\/IMG_6842.jpg 1587w\" sizes=\"auto, (max-width: 724px) 100vw, 724px\" \/><\/figure>\n<\/div>\n\n\n\n<div class=\"wp-block-column is-vertically-aligned-center is-layout-flow wp-block-column-is-layout-flow\">\n<p class=\"has-medium-font-size wp-block-paragraph\"><strong>SHIM-SHAM ist zur\u00fcck!<\/strong><br><\/p>\n\n\n\n<p class=\"has-medium-font-size wp-block-paragraph\">In dieser Saison biete ich noch einmal einen <strong>Shim-Sham-Workshop<\/strong> an! Du kannst <strong>am Samstag den 10. Oktober von 10:00 bis 14:00<\/strong> Shim-Sham von Grund auf lernen oder dein Wissen auffrischen.<\/p>\n\n\n\n<p class=\"has-medium-font-size wp-block-paragraph\">\u2728 Ein Tanz, den wirklich alle mittanzen k\u00f6nnen<br>\u2728 Kein Partner n\u00f6tig<br>\u2728 Perfekt, um sofort Teil der Community zu werden. Egal in welcher Stadt: Stell dich in die Reihe \u2013 und du bist dabei.<br><br>Diese legend\u00e4re Routine entstand in den 1920ern und wurde durch Frankie Manning in den 80ern wiederbelebt \u2013 seitdem geh\u00f6rt sie einfach dazu.<br><br>Adresse: Arnulfstr. 195, 1.OG, M\u00fcnchen<br>Preis: 55 EUR<\/p>\n\n\n\n<p class=\"has-medium-font-size wp-block-paragraph\">Anmeldung oder auch R\u00fcckfragen \u00fcber dieses <\/p>\n\n\n\n<p class=\"has-large-font-size wp-block-paragraph\"><br><a href=\"https:\/\/forms.gle\/y4jkt8LG636kpEAQ8\" target=\"_blank\" rel=\"noopener\">Formular<\/a><\/p>\n\n\n\n<p class=\"has-medium-font-size wp-block-paragraph\"> <br>Du kannst Oksana auch direkt anschreiben und dich anmelden \u00fcber +4915129198976 (WhatsApp, Signal, Telegram)<\/p>\n<\/div>\n<\/div>\n","protected":false}},{"id":1624,"date":"2026-09-03T07:51:25","link":"https:\/\/oksanapavlova.de\/aktuelles\/neuer-anfaengerkurs-lindy-hop\/","title":{"rendered":"Neuer Anf\u00e4ngerkurs Lindy Hop"},"content":{"rendered":"\n<div class=\"wp-block-columns are-vertically-aligned-center is-layout-flex wp-container-core-columns-is-layout-8f761849 wp-block-columns-is-layout-flex\">\n<div class=\"wp-block-column is-vertically-aligned-center is-layout-flow wp-block-column-is-layout-flow\"><div class=\"wp-block-image\">\n<figure class=\"aligncenter size-large\"><img loading=\"lazy\" decoding=\"async\" width=\"724\" height=\"1024\" src=\"https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/09\/Beginner-724x1024.jpg\" alt=\"\" class=\"wp-image-1634\" srcset=\"https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/09\/Beginner-724x1024.jpg 724w, https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/09\/Beginner-212x300.jpg 212w, https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/09\/Beginner-768x1086.jpg 768w, https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/09\/Beginner-1086x1536.jpg 1086w, https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/09\/Beginner-1448x2048.jpg 1448w, https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/09\/Beginner.jpg 1587w\" sizes=\"auto, (max-width: 724px) 100vw, 724px\" \/><\/figure>\n<\/div><\/div>\n\n\n\n<div class=\"wp-block-column is-vertically-aligned-center is-layout-flow wp-block-column-is-layout-flow\">\n<p class=\"has-medium-font-size wp-block-paragraph\">Ich freue mich, <strong>den Start eines neuen Lindy-Hop-Anf\u00e4ngerkurses<\/strong> ank\u00fcndigen zu k\u00f6nnen!<br><br>Der Kurs findet mittwochs von 18:30 bis 20:00 Uhr statt.<br><br>Wenn du Lindy Hop vom Anfang lernen willst, bist du herzlich zum Anf\u00e4ngerkurs eingeladen. Falls du noch jemanden kennst, der noch nicht tanzt, mit dem du aber in Zukunft gerne tanzen w\u00fcrdest, sende ihm diese Information oder erz\u00e4hl es einfach weiter!<\/p>\n\n\n\n<p class=\"has-medium-font-size wp-block-paragraph\">Adresse: Arnulfstr. 195, 1.OG, M\u00fcnchen<\/p>\n\n\n\n<p class=\"has-medium-font-size wp-block-paragraph\">Anmeldung, Preise, weitere Details, Gelegenheit f\u00fcr R\u00fcckfragen findest du hier auf diesem <\/p>\n\n\n\n<p class=\"has-large-font-size wp-block-paragraph\"><a href=\"https:\/\/forms.gle\/GxXX5M4n6NA6uD7Z6\" target=\"_blank\" rel=\"noopener\">Formular<\/a><\/p>\n\n\n\n<p class=\"has-medium-font-size wp-block-paragraph\"><br>Du kannst Oksana auch direkt anschreiben und dich anmelden \u00fcber +4915129198976 (WhatsApp, Signal, Telegram)<\/p>\n\n\n\n<p class=\"has-medium-font-size wp-block-paragraph\">Die Probestunde bzw. die Einstiegsm\u00f6glichkeiten sind:<br><\/p>\n\n\n\n<p class=\"has-medium-font-size wp-block-paragraph\">23. September 2026<br>30. September 2026<br>07. Oktober 2026<\/p>\n<\/div>\n<\/div>\n","protected":false}},{"id":1601,"date":"2026-09-01T10:21:25","link":"https:\/\/oksanapavlova.de\/aktuelles\/lindy-hop-taster-1200-und-lindy-hop-workshop-1300-am-sonntag-13-september-2026\/","title":{"rendered":"NEU: Lindy Hop Taster und Workshop am 13.09.26!"},"content":{"rendered":"\n<div class=\"wp-block-columns are-vertically-aligned-center is-layout-flex wp-container-core-columns-is-layout-8f761849 wp-block-columns-is-layout-flex\">\n<div class=\"wp-block-column is-vertically-aligned-center is-layout-flow wp-block-column-is-layout-flow\"><div class=\"wp-block-image\">\n<figure class=\"aligncenter size-large\"><img loading=\"lazy\" decoding=\"async\" width=\"819\" height=\"1024\" src=\"https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/09\/Taster-819x1024.jpg\" alt=\"\" class=\"wp-image-1636\" srcset=\"https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/09\/Taster-819x1024.jpg 819w, https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/09\/Taster-240x300.jpg 240w, https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/09\/Taster-768x960.jpg 768w, https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/09\/Taster.jpg 1080w\" sizes=\"auto, (max-width: 819px) 100vw, 819px\" \/><\/figure>\n<\/div><\/div>\n\n\n\n<div class=\"wp-block-column is-vertically-aligned-center is-layout-flow wp-block-column-is-layout-flow\">\n<p class=\"has-medium-font-size wp-block-paragraph\">Liebe Freunde,<\/p>\n\n\n\n<p class=\"has-medium-font-size wp-block-paragraph\">ab sofort gibt es regelm\u00e4\u00dfig einmal im Monat Schnupperkurse (Taster) und Workshops!<\/p>\n\n\n\n<p class=\"has-medium-font-size wp-block-paragraph\">Gleich nach den Sommerferien am 13. September 2026 der Taster um 12:00 &#8211; und wem es gef\u00e4llt, wer Zeit und Lust hat, kann gleich dableiben zum ersten Workshop f\u00fcr Anf\u00e4nger von 13:00 &#8211; 16:00 Uhr!<\/p>\n\n\n\n<p class=\"has-medium-font-size wp-block-paragraph\">Meldet euch an &#8211; alleine oder als Paar.<\/p>\n\n\n\n<p class=\"has-large-font-size wp-block-paragraph\">[<a href=\"https:\/\/forms.gle\/gwME328gt6e4dcv6A\" target=\"_blank\" rel=\"noopener\">Anmeldung<\/a>]<\/p>\n\n\n\n<p class=\"has-medium-font-size wp-block-paragraph\">Weitere Informationen gibt es hier: <a href=\"https:\/\/oksanapavlova.de\/workshops-und-schnupperkurse-taster\/\" data-type=\"page\" data-id=\"1405\">Workshops und Taster<\/a><\/p>\n\n\n\n<p class=\"has-medium-font-size wp-block-paragraph\">Und wer diesmal keine Zeit hat, findet hier die Termine f\u00fcr die kommenden Monate: <a href=\"https:\/\/oksanapavlova.de\/workshop-termine\/\" data-type=\"page\" data-id=\"1411\">Termine<\/a><\/p>\n<\/div>\n<\/div>\n\n\n\n<p class=\"wp-block-paragraph\"><\/p>\n","protected":false}},{"id":1337,"date":"2026-07-26T17:53:28","link":"https:\/\/oksanapavlova.de\/aktuelles\/danke-schoen\/","title":{"rendered":"Danke!!!"},"content":{"rendered":"\n<div class=\"wp-block-columns is-layout-flex wp-container-core-columns-is-layout-8f761849 wp-block-columns-is-layout-flex\">\n<div class=\"wp-block-column is-layout-flow wp-block-column-is-layout-flow\">\n<figure class=\"wp-block-video\"><video height=\"2560\" style=\"aspect-ratio: 1440 \/ 2560;\" width=\"1440\" controls src=\"https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/07\/IMG_5100.mp4\"><\/video><\/figure>\n<\/div>\n\n\n\n<div class=\"wp-block-column is-layout-flow wp-block-column-is-layout-flow\">\n<p class=\"wp-block-paragraph\">Liebe Freunde!<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Vielen vielen Dank f\u00fcr den Zuspruch und die Begeisterung, die ihr gestern bei &#8222;Tanz den Gasteig&#8220; gezeigt habt!<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Ich bin noch ganz \u00fcberw\u00e4ltigt, dass so viele von euch an den Workshops teilgenommen haben, die ich zusammen mit &#8222;Swing and the City&#8220; veranstaltet habt!<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Hier ein kleines Video mit Impressionen von gestern!<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Habt ihr Lust auf mehr?<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Im September starte ich mit neuen Kursen und Workshops f\u00fcr Anf\u00e4nger!<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Schaut hier auf &#8222;Aktuelles&#8220; vorbei oder abonniert meinen Newsletter<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Ich freue mich, euch im Herbst wiederzusehen!<\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><a href=\"https:\/\/forms.gle\/tVbLiHaRHHsPPHe28\" target=\"_blank\" rel=\"noreferrer noopener\">Newsletter<\/a><\/p>\n\n\n\n<div style=\"height:147px\" aria-hidden=\"true\" class=\"wp-block-spacer\"><\/div>\n\n\n\n<p class=\"wp-block-paragraph\">Und hier noch viel mehr &#8230;.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><a href=\"https:\/\/oksanapavlova.de\/choreographien-von-und-mit-mir\/\" data-type=\"page\" data-id=\"875\">Choreographien und Improvisationen von und mit mir<\/a><\/p>\n<\/div>\n<\/div>\n\n\n\n<p class=\"wp-block-paragraph\"><\/p>\n\n\n\n<figure class=\"wp-block-image size-large\"><img loading=\"lazy\" decoding=\"async\" width=\"1024\" height=\"576\" src=\"https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/07\/photo_2026-07-26_19-55-25-1024x576.jpg\" alt=\"\" class=\"wp-image-1340\" srcset=\"https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/07\/photo_2026-07-26_19-55-25-1024x576.jpg 1024w, https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/07\/photo_2026-07-26_19-55-25-300x169.jpg 300w, https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/07\/photo_2026-07-26_19-55-25-768x432.jpg 768w, https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/07\/photo_2026-07-26_19-55-25-1110x624.jpg 1110w, https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/07\/photo_2026-07-26_19-55-25-528x297.jpg 528w, https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/07\/photo_2026-07-26_19-55-25.jpg 1280w\" sizes=\"auto, (max-width: 1024px) 100vw, 1024px\" \/><\/figure>\n","protected":false}},{"id":1331,"date":"2026-07-24T09:15:41","link":"https:\/\/oksanapavlova.de\/aktuelles\/tanz-den-gasteig\/","title":{"rendered":"Tanz den Gasteig am 25.07.2026"},"content":{"rendered":"\n<div class=\"wp-block-columns is-layout-flex wp-container-core-columns-is-layout-8f761849 wp-block-columns-is-layout-flex\">\n<div class=\"wp-block-column is-layout-flow wp-block-column-is-layout-flow\"><div class=\"wp-block-image\">\n<figure class=\"aligncenter size-large\"><img loading=\"lazy\" decoding=\"async\" width=\"1024\" height=\"577\" src=\"https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/07\/photo_2026-07-24_11-12-01-1024x577.jpg\" alt=\"\" class=\"wp-image-1332\" srcset=\"https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/07\/photo_2026-07-24_11-12-01-1024x577.jpg 1024w, https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/07\/photo_2026-07-24_11-12-01-300x169.jpg 300w, https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/07\/photo_2026-07-24_11-12-01-768x433.jpg 768w, https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/07\/photo_2026-07-24_11-12-01-1110x624.jpg 1110w, https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/07\/photo_2026-07-24_11-12-01-528x297.jpg 528w, https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/07\/photo_2026-07-24_11-12-01.jpg 1280w\" sizes=\"auto, (max-width: 1024px) 100vw, 1024px\" \/><\/figure>\n<\/div><\/div>\n\n\n\n<div class=\"wp-block-column is-layout-flow wp-block-column-is-layout-flow\">\n<p class=\"wp-block-paragraph\">\ud83d\udc83 Unterschiedliche Tanzstile kostenlos ausprobieren, zu Live-Musik tanzen, mitrei\u00dfende Performances erleben \u2014 all das und noch mehr erwartet euch am 25. Juli beim Tanztag im Gasteig \ud83c\udfb6\u2728<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Dieses Jahr bin auch ich Teil des Programms. Auf der gro\u00dfen B\u00fchne gebe ich drei kostenlose Schnupperkurse:<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">\u2728 Solo Charleston<br>\u2728 Mini Stroll<br>\u2728 Two-Step<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Au\u00dferdem zeigen wir zusammen mit meinen ukrainischen Tanzsch\u00fclerinnen eine kleine Tanzshow \ud83c\uddfa\ud83c\udde6\ud83d\udc83<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Wenn ihr schon lange einen Sommerabend in guter Gesellschaft, bei Live-Musik und in t\u00e4nzerischer Atmosph\u00e4re verbringen wolltet \u2014 ich freue mich, euch dort zu sehen! \ud83e\udd70<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">\ud83d\udcc5 Ablauf des Teils, an dem ich beteiligt bin:<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">\ud83d\udd57 20:00\u201320:30 \u2014 Schnupperkurs: Solo Charleston<br>\ud83c\udfb5 20:30\u201321:10 \u2014 Live-Band Nr. 1<br>\ud83d\udd58 21:15\u201321:45 \u2014 Schnupperkurs: Two-Step<br>\ud83c\udfb5 21:50\u201322:30 \u2014 Live-Band Nr. 2<br>\ud83d\udd59 22:30\u201322:45 \u2014 Schnupperkurs: Mini Stroll<br>\ud83c\udfb5 23:00\u201323:40 \u2014 Live-Band Nr. 3<br>\ud83c\udfb7 23:40\u201324:00 \u2014 Swing-Musik von mir.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Adresse:<br>Gasteig HP8<br>Hans-Prei\u00dfinger-Stra\u00dfe 8, 81379 M\u00fcnchen<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Alle Veranstaltungen finden auf der gro\u00dfen B\u00fchne statt. Parallel dazu gibt es in anderen R\u00e4umen weitere kostenlose Tanzkurse, aber auf der gro\u00dfen B\u00fchne gibt\u2019s den meisten Spa\u00df \ud83d\ude01<\/p>\n<\/div>\n<\/div>\n\n\n\n<p class=\"wp-block-paragraph\"><\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><\/p>\n\n\n\n<p class=\"has-medium-font-size wp-block-paragraph\">Und wollt ihr f\u00fcr ein Fest oder f\u00fcr eine Feier in eurer Firma einen Auftritt gestalten, schaut hier: <a href=\"https:\/\/oksanapavlova.de\/tanzperformances\/\" data-type=\"page\" data-id=\"478\">TANZPERFORMANCES<\/a><\/p>\n","protected":false}},{"id":1296,"date":"2026-06-29T09:15:36","link":"https:\/\/oksanapavlova.de\/aktuelles\/lindy-hop-workshop-fuer-fortgeschrittene-am-12-07-2026\/","title":{"rendered":"Lindy Hop Workshop f\u00fcr Fortgeschrittene am 12.07.2026"},"content":{"rendered":"\n<div class=\"wp-block-columns is-layout-flex wp-container-core-columns-is-layout-8f761849 wp-block-columns-is-layout-flex\">\n<div class=\"wp-block-column is-layout-flow wp-block-column-is-layout-flow\">\n<figure class=\"wp-block-image size-large\"><img loading=\"lazy\" decoding=\"async\" width=\"1024\" height=\"1024\" src=\"https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/06\/2026-07-12-LH-FG-WS-Poster-1024x1024.jpg\" alt=\"\" class=\"wp-image-1297\" srcset=\"https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/06\/2026-07-12-LH-FG-WS-Poster-1024x1024.jpg 1024w, https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/06\/2026-07-12-LH-FG-WS-Poster-300x300.jpg 300w, https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/06\/2026-07-12-LH-FG-WS-Poster-150x150.jpg 150w, https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/06\/2026-07-12-LH-FG-WS-Poster-768x768.jpg 768w, https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/06\/2026-07-12-LH-FG-WS-Poster-510x510.jpg 510w, https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/06\/2026-07-12-LH-FG-WS-Poster.jpg 1080w\" sizes=\"auto, (max-width: 1024px) 100vw, 1024px\" \/><\/figure>\n<\/div>\n\n\n\n<div class=\"wp-block-column is-layout-flow wp-block-column-is-layout-flow\">\n<p class=\"wp-block-paragraph\">Lindy-Hop-Workshop f\u00fcr Fortgeschrittene!<br><strong>Was, wenn dein \u201e8-Count\u201c gar kein echter 8-Count ist?<\/strong><br>\u00a0<br>In diesem Workshop f\u00fcr fortgeschrittene Lindy-Hop-T\u00e4nzer nehmen wir bekannte Figuren wie den Swing-Out, den 8-Count-Grundschritt und Charleston unter die Lupe \u2013 und dehnen sie \u00fcber ihre gewohnte Form hinaus aus. Lerne, wie du deine Bewegungen durch Rhythmusvariationen erweitern, komprimieren und neu gestalten kannst \u2013 auf 4, 6, 10 oder sogar 12 Counts.<br>Dieselben Moves. Neues Timing. Unendliche M\u00f6glichkeiten.<br>\u00a0<br>Wer: Oksana (UKR) &amp; David C. Tritel (USA)<br>Wann: Sonntag, 12. Juli 2026, 15:00\u201318:00 Uhr<br>Wo: Arnulfstr. 195, 1. OG<br>Preis: 60 EUR<br>Sprache: Englisch mit \u00dcbersetzung ins Deutsche<br>\u00a0<br>Anmeldung \u00fcber den untenstehenden Link oder per Direktnachricht (PM) an Oksana.<br><a href=\"https:\/\/forms.gle\/TsmeeXVgDzYerWtH9\" target=\"_blank\" rel=\"noopener\">https:\/\/forms.gle\/TsmeeXVgDzYerWtH9<\/a><\/p>\n<\/div>\n<\/div>\n","protected":false}},{"id":1292,"date":"2026-06-27T09:41:33","link":"https:\/\/oksanapavlova.de\/aktuelles\/blues-workshop-am-11-07-2026\/","title":{"rendered":"Blues Workshop am 11.07.2026"},"content":{"rendered":"\n<div class=\"wp-block-columns is-layout-flex wp-container-core-columns-is-layout-8f761849 wp-block-columns-is-layout-flex\">\n<div class=\"wp-block-column is-layout-flow wp-block-column-is-layout-flow\">\n<figure class=\"wp-block-image size-large\"><img loading=\"lazy\" decoding=\"async\" width=\"819\" height=\"1024\" src=\"https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/06\/Blues-WS-Poster-819x1024.jpg\" alt=\"\" class=\"wp-image-1293\" srcset=\"https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/06\/Blues-WS-Poster-819x1024.jpg 819w, https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/06\/Blues-WS-Poster-240x300.jpg 240w, https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/06\/Blues-WS-Poster-768x960.jpg 768w, https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/06\/Blues-WS-Poster.jpg 1080w\" sizes=\"auto, (max-width: 819px) 100vw, 819px\" \/><\/figure>\n<\/div>\n\n\n\n<div class=\"wp-block-column is-layout-flow wp-block-column-is-layout-flow\">\n<p class=\"wp-block-paragraph\">Liebe T\u00e4nzer,<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">der Blues sollte nicht in der Sommerhitze dahinschmelzen \u2013 und wir sollten auch keinen ganzen Monat ohne Blues-Workshop verbringen.<br>Lasst uns also diesen Juli den Blues lebendig halten \u2026 und in Bewegung bleiben.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Ich m\u00f6chte alle Blues-Liebhaber herzlich zum n\u00e4chsten Blues-Dance-Workshop einladen. Geleitet wird er von Oksana, diesmal gemeinsam mit David C. Tritel, einem Swing- und Blues-Tanzlehrer aus den USA. \u2728<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">In diesem dreist\u00fcndigen Workshop behandeln wir zwei Themen: \u201eThe 8 Directional Slide\u201c und \u201eOppositional Steps\u201c. Bei beiden Themen geht es darum, neue Ideen zu erkunden und euren t\u00e4nzerischen Werkzeugkasten mit praktischen Bewegungen zu f\u00fcllen, die ihr direkt beim Social Dance auf der n\u00e4chsten \u201eDouble Hop\u201c-Party am 18. Juli anwenden k\u00f6nnt. Kommt vorbei, tanzt, lernt und entdeckt, wie viel Tiefe in den kleinsten Details stecken kann \ud83e\udd0d<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Wann: 11. Juli, 12:00\u201315:00 Uhr<br>Wo: Arnulfstr. 195, 1. OG<br>Preis: 50 EUR<br>Die Anmeldung erfolgt \u00fcber den folgenden Link:<br><a href=\"https:\/\/forms.gle\/TimRn4BP1ASoencEA\" target=\"_blank\" rel=\"noopener\">https:\/\/forms.gle\/TimRn4BP1ASoencEA<\/a><\/p>\n<\/div>\n<\/div>\n","protected":false}},{"id":1287,"date":"2026-06-27T09:36:23","link":"https:\/\/oksanapavlova.de\/aktuelles\/lindy-hop-workshop-am-12-07-2026\/","title":{"rendered":"Lindy Hop Workshop am 12.07.2026"},"content":{"rendered":"\n<div class=\"wp-block-columns is-layout-flex wp-container-core-columns-is-layout-8f761849 wp-block-columns-is-layout-flex\">\n<div class=\"wp-block-column is-layout-flow wp-block-column-is-layout-flow\">\n<figure class=\"wp-block-image size-large\"><img loading=\"lazy\" decoding=\"async\" width=\"819\" height=\"1024\" src=\"https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/06\/2026-07-12-LH-Beg-WS-Poster-819x1024.jpg\" alt=\"\" class=\"wp-image-1288\" srcset=\"https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/06\/2026-07-12-LH-Beg-WS-Poster-819x1024.jpg 819w, https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/06\/2026-07-12-LH-Beg-WS-Poster-240x300.jpg 240w, https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/06\/2026-07-12-LH-Beg-WS-Poster-768x960.jpg 768w, https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/06\/2026-07-12-LH-Beg-WS-Poster.jpg 1080w\" sizes=\"auto, (max-width: 819px) 100vw, 819px\" \/><\/figure>\n<\/div>\n\n\n\n<div class=\"wp-block-column is-layout-flow wp-block-column-is-layout-flow\">\n<p class=\"wp-block-paragraph\">SICHER UND EINFACH BEI SCHNELLEREN TEMPI TANZEN<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Wenn man gerade erst mit dem Lindy Hop begonnen hat oder nur \u00fcber Grundkenntnisse verf\u00fcgt, k\u00f6nnen schnelle Songs eine Herausforderung darstellen \u2013 das m\u00fcssen sie aber nicht. Wir schauen uns einfache Schritte an, mit denen du die meisten Tempi meistern kannst, die bei Swing-Tanzveranstaltungen gespielt werden.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Dieser Workshop richtet sich an alle, die sich f\u00fcr Lindy Hop interessieren, aber noch wenig Erfahrung haben und sich fit f\u00fcr das Social Dancing machen m\u00f6chten.<br>Der Workshop ist geeignet f\u00fcr Teilnehmer, die bereits die Level LH1 oder LH2 absolviert haben oder \u00fcber Erfahrung in anderen Paart\u00e4nzen verf\u00fcgen.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Wann: Sonntag, 12. Juli, 11:00\u201314:00 Uhr<br>Wo: Arnulfstr. 195, 1. OG<br>Preis: 50 EUR<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Anmeldung \u00fcber den untenstehenden Link oder per Privatnachricht (PM):<br><a href=\"https:\/\/forms.gle\/y59xAN4b4dzqT8N47\" target=\"_blank\" rel=\"noopener\">https:\/\/forms.gle\/y59xAN4b4dzqT8N47<\/a><\/p>\n<\/div>\n<\/div>\n","protected":false}},{"id":1265,"date":"2026-05-02T10:18:06","link":"https:\/\/oksanapavlova.de\/aktuelles\/shim-sham-workshop-am-31-05-2026\/","title":{"rendered":"Shim Sham Workshop am 31.05.2026"},"content":{"rendered":"\n<div class=\"wp-block-columns is-layout-flex wp-container-core-columns-is-layout-8f761849 wp-block-columns-is-layout-flex\">\n<div class=\"wp-block-column is-layout-flow wp-block-column-is-layout-flow\">\n<figure class=\"wp-block-image size-large\"><img loading=\"lazy\" decoding=\"async\" width=\"724\" height=\"1024\" src=\"https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/05\/2026-05-31-Shim-Sham-WS-724x1024.jpg\" alt=\"\" class=\"wp-image-1253\" srcset=\"https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/05\/2026-05-31-Shim-Sham-WS-724x1024.jpg 724w, https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/05\/2026-05-31-Shim-Sham-WS-212x300.jpg 212w, https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/05\/2026-05-31-Shim-Sham-WS-768x1086.jpg 768w, https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/05\/2026-05-31-Shim-Sham-WS-1086x1536.jpg 1086w, https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/05\/2026-05-31-Shim-Sham-WS-1448x2048.jpg 1448w, https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/05\/2026-05-31-Shim-Sham-WS.jpg 1587w\" sizes=\"auto, (max-width: 724px) 100vw, 724px\" \/><\/figure>\n<\/div>\n\n\n\n<div class=\"wp-block-column is-layout-flow wp-block-column-is-layout-flow\">\n<p class=\"wp-block-paragraph\">Falls du am 3. Mai nicht am Shim-Sham-Workshop teilnehmen konntest, kein Problem. Du kannst bei mir am Sonntag, den 31. Mai von 12:00 bis 15:00, Shim-Sham lernen oder dein Wissen auffrischen.<br>Zum Welttag des Lindy Hop biete ich einen weiteren Shim-Sham-Workshop an!<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">\u2728 Ein Tanz, den wirklich alle mittanzen k\u00f6nnen<br>\u2728 Kein Partner n\u00f6tig<br>\u2728 Perfekt, um sofort Teil der Community zu werden. Egal in welcher Stadt: Stell dich in die Reihe \u2013 und du bist dabei.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Diese legend\u00e4re Routine entstand in den 1920ern und wurde durch Frankie Manning in den 80ern wiederbelebt \u2013 seitdem geh\u00f6rt sie einfach dazu.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Adresse: Arnulfstr. 195, 1.OG, M\u00fcnchen<br>Preis: 50 EUR<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">\ud83d\udc49 Bei Interesse kannst du den untenstehenden Google-Form-Link nutzen, um dich anzumelden oder Fragen zu stellen:<br><a href=\"https:\/\/forms.gle\/LSQYAxfRPKa2sBzE7\" target=\"_blank\" rel=\"noopener\">https:\/\/forms.gle\/LSQYAxfRPKa2sBzE7<\/a><\/p>\n<\/div>\n<\/div>\n","protected":false}},{"id":1259,"date":"2026-05-02T10:07:43","link":"https:\/\/oksanapavlova.de\/aktuelles\/blues-workshop-am-16-mai-2026\/","title":{"rendered":"Blues Workshop am 16. Mai 2026"},"content":{"rendered":"\n<div class=\"wp-block-columns is-layout-flex wp-container-core-columns-is-layout-8f761849 wp-block-columns-is-layout-flex\">\n<div class=\"wp-block-column is-layout-flow wp-block-column-is-layout-flow\">\n<figure class=\"wp-block-image size-large\"><img loading=\"lazy\" decoding=\"async\" width=\"724\" height=\"1024\" src=\"https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/05\/2026-05-16-Blues-WS-BN-724x1024.jpg\" alt=\"\" class=\"wp-image-1251\" srcset=\"https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/05\/2026-05-16-Blues-WS-BN-724x1024.jpg 724w, https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/05\/2026-05-16-Blues-WS-BN-212x300.jpg 212w, https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/05\/2026-05-16-Blues-WS-BN-768x1086.jpg 768w, https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/05\/2026-05-16-Blues-WS-BN-1086x1536.jpg 1086w, https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/05\/2026-05-16-Blues-WS-BN-1448x2048.jpg 1448w, https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/05\/2026-05-16-Blues-WS-BN.jpg 1587w\" sizes=\"auto, (max-width: 724px) 100vw, 724px\" \/><\/figure>\n<\/div>\n\n\n\n<div class=\"wp-block-column is-layout-flow wp-block-column-is-layout-flow\">\n<p class=\"wp-block-paragraph\">Im Mai bieten wir am Samstag, 16. Mai von 16:00 bis 19:00 Uhr wieder einen dreist\u00fcndigen Blues-Workshop f\u00fcr leicht Fortgeschrittene an (einige Vorkenntnisse im Blues oder Swing sind erforderlich). Der Schwerpunkt liegt auf Ballroomin&#8216; Stil von Blues mit dynamischen Figuren und Dips und Elementen aus dem Slow Drag.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Aber nicht nur das! Dieses Mal findet im Anschluss an den Workshop von 19:30 bis 22:30 Uhr die Bluesnight statt. Die Workshop-Teilnehmer erhalten 50 % Erm\u00e4\u00dfigung auf den Eintritt zur Bluesnight.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Adresse: Arnulfstr. 195, 1.OG, M\u00fcnchen<br>Preis: 50 EUR (55 EUR mit Bluesnight)<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Bei Interesse melde dich direkt bei mir an +4915129198976 (Telegram, WhatsApp, Signal) oder beim Link: <\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><a href=\"https:\/\/forms.gle\/UtKFibQkQ4o7LsA88\" target=\"_blank\" rel=\"noopener\">https:\/\/forms.gle\/UtKFibQkQ4o7LsA88<\/a><\/p>\n<\/div>\n<\/div>\n","protected":false}},{"id":1254,"date":"2026-05-02T10:03:02","link":"https:\/\/oksanapavlova.de\/aktuelles\/workshop-solotanz-charleston-am-16-mai-2026-von-1230-bis-15-30\/","title":{"rendered":"Workshop Solotanz Charleston am 16. Mai 2026"},"content":{"rendered":"\n<div class=\"wp-block-columns is-layout-flex wp-container-core-columns-is-layout-8f761849 wp-block-columns-is-layout-flex\">\n<div class=\"wp-block-column is-layout-flow wp-block-column-is-layout-flow\">\n<figure class=\"wp-block-image size-large\"><img loading=\"lazy\" decoding=\"async\" width=\"724\" height=\"1024\" src=\"https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/05\/2026-05-16-Solo-WS-Charleston-724x1024.jpg\" alt=\"\" class=\"wp-image-1250\" srcset=\"https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/05\/2026-05-16-Solo-WS-Charleston-724x1024.jpg 724w, https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/05\/2026-05-16-Solo-WS-Charleston-212x300.jpg 212w, https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/05\/2026-05-16-Solo-WS-Charleston-768x1086.jpg 768w, https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/05\/2026-05-16-Solo-WS-Charleston-1086x1536.jpg 1086w, https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/05\/2026-05-16-Solo-WS-Charleston-1448x2048.jpg 1448w, https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/05\/2026-05-16-Solo-WS-Charleston.jpg 1587w\" sizes=\"auto, (max-width: 724px) 100vw, 724px\" \/><\/figure>\n<\/div>\n\n\n\n<div class=\"wp-block-column is-layout-flow wp-block-column-is-layout-flow\">\n<p class=\"wp-block-paragraph\">Wer sich f\u00fcr Charleston Solotanz interessiert, sollte sich diese Gelegenheit nicht entgehen lassen!<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">In einem Tanzworkshop am Samstag, 16. Mai von 12:30 bis 15:30 Uhr, lernst du Charleston und tanzt einfache Schrittfolgen ohne Partner. Charleston entstand in den afro-amerikanischen Gemeinden zwischen den 1920er und 1940er Jahren und wird zu schnellerem Swing oder New Orleans Jazz getanzt.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Komm dazu, um die fr\u00f6hlichen Charleston-Elemente zu lernen und Spa\u00df am \u00dcben zu haben.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Adresse: Arnulfstr. 195, 1.OG, M\u00fcnchen<br>Preis: 50 EUR<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Bei Interesse kann man den untenstehenden Google-Form-Link nutzen, um sich anzumelden oder Fragen zu stellen.<br><a href=\"https:\/\/forms.gle\/44no4BYWDFiAizDr8\" target=\"_blank\" rel=\"noopener\">https:\/\/forms.gle\/44no4BYWDFiAizDr8<\/a><br>Oder mir direkt schreiben und sich einen Platz sichern!<\/p>\n<\/div>\n<\/div>\n","protected":false}},{"id":1248,"date":"2026-04-30T12:59:28","link":"https:\/\/oksanapavlova.de\/aktuelles\/shim-sham-workshop-am-03-05-2026\/","title":{"rendered":"Shim Sham Workshop am 03.05.2026"},"content":{"rendered":"\n<div class=\"wp-block-columns is-layout-flex wp-container-core-columns-is-layout-8f761849 wp-block-columns-is-layout-flex\">\n<div class=\"wp-block-column is-layout-flow wp-block-column-is-layout-flow\">\n<figure class=\"wp-block-image size-large\"><img loading=\"lazy\" decoding=\"async\" width=\"724\" height=\"1024\" src=\"https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/04\/2026-05-03-Shim-Sham-WS-724x1024.jpg\" alt=\"\" class=\"wp-image-1247\" srcset=\"https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/04\/2026-05-03-Shim-Sham-WS-724x1024.jpg 724w, https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/04\/2026-05-03-Shim-Sham-WS-212x300.jpg 212w, https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/04\/2026-05-03-Shim-Sham-WS-768x1086.jpg 768w, https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/04\/2026-05-03-Shim-Sham-WS-1086x1536.jpg 1086w, https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/04\/2026-05-03-Shim-Sham-WS-1448x2048.jpg 1448w, https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/04\/2026-05-03-Shim-Sham-WS.jpg 1587w\" sizes=\"auto, (max-width: 724px) 100vw, 724px\" \/><\/figure>\n<\/div>\n\n\n\n<div class=\"wp-block-column is-layout-flow wp-block-column-is-layout-flow\">\n<p class=\"wp-block-paragraph\">In nur einem Workshop mittanzen k\u00f6nnen \u2013 ohne monatelanges Training? Ja, das geht.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Der Shim Sham ist DER Klassiker der Swing-Szene \u2013 getanzt auf Festivals weltweit, immer mit einer gro\u00dfen Gruppe und unglaublicher Energie.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">\u2728 Ein Tanz, den wirklich alle mittanzen k\u00f6nnen<br>\u2728 Kein Partner n\u00f6tig<br>\u2728 Perfekt, um sofort Teil der Community zu werden<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Diese legend\u00e4re Routine entstand in den 1920ern und wurde durch Frankie Manning in den 80ern wiederbelebt \u2013 seitdem geh\u00f6rt sie einfach dazu.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Egal in welcher Stadt: Stell dich in die Reihe \u2013 und du bist dabei.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">\ud83d\udc49 Lerne den Shim Sham in meinem Workshop<br>\ud83d\udce9 Schreib mir direkt und sichere dir deinen Platz!<\/p>\n<\/div>\n<\/div>\n","protected":false}},{"id":1243,"date":"2026-04-15T12:34:56","link":"https:\/\/oksanapavlova.de\/aktuelles\/magst-du-jazzmusik-dann-wirst-du-es-lieben-dazu-zu-tanzen\/","title":{"rendered":"Magst du Jazzmusik? Dann wirst du es lieben, dazu zu tanzen!"},"content":{"rendered":"\n<div class=\"wp-block-columns is-layout-flex wp-container-core-columns-is-layout-8f761849 wp-block-columns-is-layout-flex\">\n<div class=\"wp-block-column is-layout-flow wp-block-column-is-layout-flow\"><div class=\"wp-block-image\">\n<figure class=\"aligncenter size-large\"><img loading=\"lazy\" decoding=\"async\" width=\"724\" height=\"1024\" src=\"https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/04\/2026-04-23-Solo-Tester-724x1024.jpg\" alt=\"\" class=\"wp-image-1244\" srcset=\"https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/04\/2026-04-23-Solo-Tester-724x1024.jpg 724w, https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/04\/2026-04-23-Solo-Tester-212x300.jpg 212w, https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/04\/2026-04-23-Solo-Tester-768x1086.jpg 768w, https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/04\/2026-04-23-Solo-Tester-1086x1536.jpg 1086w, https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/04\/2026-04-23-Solo-Tester-1448x2048.jpg 1448w, https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/04\/2026-04-23-Solo-Tester.jpg 1587w\" sizes=\"auto, (max-width: 724px) 100vw, 724px\" \/><\/figure>\n<\/div><\/div>\n\n\n\n<div class=\"wp-block-column is-layout-flow wp-block-column-is-layout-flow\">\n<p class=\"wp-block-paragraph\">Im Solo Jazz brauchst du keinen Partner &#8211; nur dich selbst, deine Energie und deine Pers\u00f6nlichkeit. Keine Grenzen, nur Ausdruck und Freude an der Bewegung.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">\u2728Kostenlose Probestunde<br>\ud83d\udcc5Donnerstag, 23. April und 30. April<br>\ud83d\udd6118:30-20:00<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Nach dem Workshop kannst du direkt weitermachen:<br>W\u00f6chentlicher Kurs &#8211; 90 \u20ac f\u00fcr 4 Einheiten \u00e0 1,5 Stunden.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">\ud83d\udc49 Melde dich \u00fcber den Link an oder schreib mir direkt, wenn du Fragen hast.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><a href=\"https:\/\/forms.gle\/nQaz91JAyFmouLQDA\" target=\"_blank\" rel=\"noopener\">https:\/\/forms.gle\/nQaz91JAyFmouLQDA<\/a><\/p>\n<\/div>\n<\/div>\n\n\n\n<p class=\"wp-block-paragraph\"><\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><\/p>\n","protected":false}},{"id":1237,"date":"2026-03-03T13:18:32","link":"https:\/\/oksanapavlova.de\/aktuelles\/kostenlose-probestunde-zum-start-des-neuen-lindy-hop-tanzkurses\/","title":{"rendered":"Kostenlose Probestunde zum Start des  neuen Lindy-Hop-Tanzkurses"},"content":{"rendered":"\n<div class=\"wp-block-columns is-layout-flex wp-container-core-columns-is-layout-8f761849 wp-block-columns-is-layout-flex\">\n<div class=\"wp-block-column is-layout-flow wp-block-column-is-layout-flow\">\n<figure class=\"wp-block-image size-large\"><img loading=\"lazy\" decoding=\"async\" width=\"724\" height=\"1024\" src=\"https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/03\/2026-04-LH-Probestunde-POSTER-724x1024.jpg\" alt=\"\" class=\"wp-image-1238\" srcset=\"https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/03\/2026-04-LH-Probestunde-POSTER-724x1024.jpg 724w, https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/03\/2026-04-LH-Probestunde-POSTER-212x300.jpg 212w, https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/03\/2026-04-LH-Probestunde-POSTER-768x1086.jpg 768w, https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/03\/2026-04-LH-Probestunde-POSTER-1086x1536.jpg 1086w, https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/03\/2026-04-LH-Probestunde-POSTER-1448x2048.jpg 1448w, https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/03\/2026-04-LH-Probestunde-POSTER.jpg 1587w\" sizes=\"auto, (max-width: 724px) 100vw, 724px\" \/><\/figure>\n<\/div>\n\n\n\n<div class=\"wp-block-column is-layout-flow wp-block-column-is-layout-flow\">\n<p class=\"wp-block-paragraph\">Liebe Freundin \/ lieber Freund \ud83d\udc4b<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">ich freue mich darauf, den Start meines Lindy-Hop-Anf\u00e4ngerkurses anzuk\u00fcndigen.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Der Kurs findet mittwochs von 18:30 bis 20:00 Uhr statt. \ud83d\udc83\ud83d\udd7a\u2728<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Ich lade Dich herzlich zur ersten kostenlosen und unverbindlichen Schnupperstunde ein. \ud83c\udf81<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Einen Partner \/ eine Partnerin brauchst Du nicht unbedingt \u2014 wir werden immer Partner wechseln. \ud83d\udd04<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Was brauchst Du dann?<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Nur bequeme Schuhe \ud83d\udc5f und gute Laune! \ud83d\ude04\ud83c\udf89<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">\ud83d\udcdd Bitte nutzt zur Anmeldung oder bei Fragen den untenstehenden Google-Form-Link:<\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><a href=\"https:\/\/forms.gle\/LrJaUPJaCAcwG5hX9\" target=\"_blank\" rel=\"noopener\">https:\/\/forms.gle\/LrJaUPJaCAcwG5hX9<\/a><\/p>\n<\/div>\n<\/div>\n","protected":false}},{"id":1232,"date":"2026-03-03T12:42:24","link":"https:\/\/oksanapavlova.de\/aktuelles\/wiener-walzer-workshop-fuer-swingtaenzer\/","title":{"rendered":"Wiener Walzer Workshop f\u00fcr Swingt\u00e4nzer &#8211; 2 Stufen"},"content":{"rendered":"\n<div class=\"wp-block-columns is-layout-flex wp-container-core-columns-is-layout-8f761849 wp-block-columns-is-layout-flex\">\n<div class=\"wp-block-column is-layout-flow wp-block-column-is-layout-flow\">\n<figure class=\"wp-block-image size-large\"><img loading=\"lazy\" decoding=\"async\" width=\"724\" height=\"1024\" src=\"https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/03\/Va-724x1024.jpg\" alt=\"\" class=\"wp-image-1235\" srcset=\"https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/03\/Va-724x1024.jpg 724w, https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/03\/Va-212x300.jpg 212w, https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/03\/Va-768x1086.jpg 768w, https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/03\/Va-1086x1536.jpg 1086w, https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/03\/Va-1448x2048.jpg 1448w, https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/03\/Va.jpg 1587w\" sizes=\"auto, (max-width: 724px) 100vw, 724px\" \/><\/figure>\n<\/div>\n\n\n\n<div class=\"wp-block-column is-layout-flow wp-block-column-is-layout-flow\">\n<p class=\"wp-block-paragraph\">Liebe Swingt\u00e4nzer! \ud83d\udc83\ud83d\udd7a<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Ist es euch auch schon mal passiert, dass ihr auf einer Swingtanzparty oder auf einer Countrytanzparty einen Wiener Walzer h\u00f6rt und nicht wisst, was ihr dazu machen sollt? \ud83e\udd14<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">\u00dcbrigens ist der Grundschritt des Wiener Walzers viel einfacher als der Swing Out und l\u00e4sst sich schnell erlernen. \u2728<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Wir, Oksana und Erich, bieten zwei jeweils zweist\u00fcndige Workshops f\u00fcr verschiedene Niveaus an.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">\ud83d\udfe2 11.00\u201313.00 \u2022 1. Stufe<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Sie richtet sich an T\u00e4nzer anderer Stile, die gerne Walzer tanzen lernen m\u00f6chten, wenn die Musik es tut.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Der erste Workshop ist f\u00fcr alle mit Grundvorkenntnissen in anderen T\u00e4nzen.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Wir \u00fcben die grundlegende Rechtsdrehung zu verschiedenen Liedern. \ud83c\udfb6<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">\ud83d\udd35 13.30\u201315.30 \u2022 2. Stufe<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Der zweite Workshop ist f\u00fcr fortgeschrittenere T\u00e4nzer verschiedener Stile gedacht, die den Walzer von Grund auf lernen m\u00f6chten.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">In dieser Gruppe lernen wir Rechts- und Linksdrehungen sowie \u00dcberg\u00e4nge und Pivot-Drehungen. \ud83d\udd04<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">\ud83d\udcb0 Der Preis betr\u00e4gt 35 EUR pro Workshop.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">\ud83d\udcb8 Insgesamt kostet der Workshop 60 EUR f\u00fcr beide Workshops.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">\ud83d\udc26 Early Bird Preis \u2013 bei Anmeldung bis zum 10. M\u00e4rz 2026:<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">\u2022 30 EUR pro Stufe<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">\u2022 50 EUR f\u00fcr beide<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">\ud83d\udc6b Anmeldungen mit einem Tanzpartner \/ einer Tanzpartnerin werden bevorzugt behandelt.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">\ud83d\udcdd Bitte nutzt zur Anmeldung den untenstehenden Google-Form-Link:<\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><a href=\"https:\/\/forms.gle\/ocJVsZuuUfjFRJYB6\" target=\"_blank\" rel=\"noopener\">https:\/\/forms.gle\/ocJVsZuuUfjFRJYB6<\/a><\/p>\n<\/div>\n<\/div>\n","protected":false}},{"id":1211,"date":"2026-02-27T14:02:43","link":"https:\/\/oksanapavlova.de\/aktuelles\/blues-workshop\/","title":{"rendered":"Blues Workshop am 07. M\u00e4rz 2026 von 16:00 bis 19:00"},"content":{"rendered":"\n<div class=\"wp-block-columns is-layout-flex wp-container-core-columns-is-layout-8f761849 wp-block-columns-is-layout-flex\">\n<div class=\"wp-block-column is-layout-flow wp-block-column-is-layout-flow\">\n<figure class=\"wp-block-image size-large\"><img loading=\"lazy\" decoding=\"async\" width=\"819\" height=\"1024\" src=\"https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/03\/Maerz-819x1024.jpg\" alt=\"\" class=\"wp-image-1229\" srcset=\"https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/03\/Maerz-819x1024.jpg 819w, https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/03\/Maerz-240x300.jpg 240w, https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/03\/Maerz-768x960.jpg 768w, https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/03\/Maerz.jpg 1080w\" sizes=\"auto, (max-width: 819px) 100vw, 819px\" \/><\/figure>\n<\/div>\n\n\n\n<div class=\"wp-block-column is-layout-flow wp-block-column-is-layout-flow\">\n<p class=\"wp-block-paragraph\">Liebe Blues Lovers,<br><br>Ich biete am 7. M\u00e4rz von 16:00 bis 19:00 Uhr einen dreist\u00fcndigen Blues-Workshop f\u00fcr leicht Fortgeschrittene an (einige Vorkenntnisses im Blues oder Swing sind erforderlich).<br><br>Der Schwerpunkt liegt auf Ballroomin&#8217;Stil von Blues mit dynamischen Figuren und Dips und Elementen aus dem Slow Drag.<br><br>Bei Interesse meldet euch bitte per Email oder direkt bei mir (Siehe unter &#8222;Kontakte&#8220;).<\/p>\n<\/div>\n<\/div>\n","protected":false}},{"id":1193,"date":"2026-02-07T16:54:48","link":"https:\/\/oksanapavlova.de\/aktuelles\/kostenlose-probestunde-lindy-hop-am-11-02-2026\/","title":{"rendered":"Kostenlose Probestunde Lindy Hop am 11.02.2026"},"content":{"rendered":"\n<figure class=\"wp-block-image size-large\"><img loading=\"lazy\" decoding=\"async\" width=\"819\" height=\"1024\" src=\"https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/02\/Stat-819x1024.jpg\" alt=\"\" class=\"wp-image-1194\" srcset=\"https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/02\/Stat-819x1024.jpg 819w, https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/02\/Stat-240x300.jpg 240w, https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/02\/Stat-768x960.jpg 768w, https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/02\/Stat.jpg 1080w\" sizes=\"auto, (max-width: 819px) 100vw, 819px\" \/><\/figure>\n","protected":false}},{"id":1189,"date":"2026-01-21T18:14:01","link":"https:\/\/oksanapavlova.de\/aktuelles\/woechentlicher-lindy-hop-kurs-fuer-anfaenger-mittwochs-von-2000-bis-2130-uhr-probestunde-kostenlos\/","title":{"rendered":"W\u00f6chentlicher Lindy-Hop-Kurs f\u00fcr Anf\u00e4nger mittwochs von 20:00 bis 21:30 Uhr. Probestunde kostenlos!"},"content":{"rendered":"\n<figure class=\"wp-block-image size-large\"><img loading=\"lazy\" decoding=\"async\" width=\"819\" height=\"1024\" src=\"https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/01\/2026-01-LH-Group-Start-819x1024.jpg\" alt=\"\" class=\"wp-image-1186\" srcset=\"https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/01\/2026-01-LH-Group-Start-819x1024.jpg 819w, https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/01\/2026-01-LH-Group-Start-240x300.jpg 240w, https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/01\/2026-01-LH-Group-Start-768x960.jpg 768w, https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/01\/2026-01-LH-Group-Start.jpg 1080w\" sizes=\"auto, (max-width: 819px) 100vw, 819px\" \/><\/figure>\n","protected":false}},{"id":1103,"date":"2025-12-23T19:42:24","link":"https:\/\/oksanapavlova.de\/ankuendigungen\/ab-januar-woechentliche-kurse-im-kulturzentrum-gorod\/","title":{"rendered":"Ab Januar: w\u00f6chentliche Kurse im Kulturzentrum GOROD!"},"content":{"rendered":"\n<figure class=\"wp-block-image size-large\"><img loading=\"lazy\" decoding=\"async\" width=\"724\" height=\"1024\" src=\"https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/01\/Poster-A3-1-1-724x1024.jpg\" alt=\"\" class=\"wp-image-1180\" srcset=\"https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/01\/Poster-A3-1-1-724x1024.jpg 724w, https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/01\/Poster-A3-1-1-212x300.jpg 212w, https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/01\/Poster-A3-1-1-768x1086.jpg 768w, https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/01\/Poster-A3-1-1-1086x1536.jpg 1086w, https:\/\/oksanapavlova.de\/wp-content\/uploads\/2026\/01\/Poster-A3-1-1.jpg 1414w\" sizes=\"auto, (max-width: 724px) 100vw, 724px\" \/><\/figure>\n","protected":false}}]