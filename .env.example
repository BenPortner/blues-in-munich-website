# Copy to .env and fill in. .env is git-ignored; CI reads the same name from a repository secret.
# Free key: https://developer.ticketmaster.com
TICKETMASTER_API_KEY=
# Free key: https://www.last.fm/api/account/create (well-known artists as highlights)
# Last.fm's terms require its written approval before this goes on the public site.
LASTFM_API_KEY=
